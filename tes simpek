<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Untuk Eci Buls 🎀</title>
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    body{
      min-height:100vh;font-family:"Trebuchet MS","Comic Sans MS",cursive;
      background:
        radial-gradient(circle at 15% 20%,rgba(255,255,255,.9) 0 3px,transparent 4px),
        radial-gradient(circle at 85% 15%,rgba(255,255,255,.8) 0 4px,transparent 5px),
        linear-gradient(135deg,#ffc5da 0%,#fff7fa 45%,#fff1b8 100%);
      background-size:120px 120px,150px 150px,100% 100%;
      display:flex;justify-content:center;align-items:center;padding:20px;overflow:hidden;color:#7d5363
    }
    .decor{position:fixed;pointer-events:none;z-index:1;color:#e89ab7;animation:floating 4s ease-in-out infinite}
    .d1{top:7%;left:8%;font-size:45px}.d2{top:15%;right:9%;font-size:32px;animation-delay:1s}
    .d3{bottom:12%;left:9%;font-size:35px;animation-delay:2s}.d4{bottom:9%;right:10%;font-size:42px;animation-delay:1.5s}
    .d5{top:45%;left:3%;font-size:20px;animation-delay:.5s}.d6{top:55%;right:3%;font-size:22px;animation-delay:2.5s}
    @keyframes floating{0%,100%{transform:translateY(0) rotate(-5deg)}50%{transform:translateY(-12px) rotate(5deg)}}
    .container{width:100%;max-width:650px;position:relative;z-index:5}
    .card{
      position:relative;background:rgba(255,255,255,.88);border:2px solid rgba(231,151,180,.7);
      border-radius:35px;padding:35px 30px;text-align:center;
      box-shadow:0 12px 35px rgba(190,110,140,.18),inset 0 0 30px rgba(255,225,236,.5)
    }
    .card::before{content:"🎀";position:absolute;top:-28px;left:50%;transform:translateX(-50%);font-size:55px}
    .mini-title{display:inline-block;margin-top:8px;margin-bottom:15px;padding:7px 18px;border-radius:50px;
      background:linear-gradient(90deg,#ffd3e2,#fff8cf);border:1px solid #f0b4c9;color:#b86684;font-size:13px;letter-spacing:1px;font-weight:bold}
    h1{color:#c95c82;font-size:clamp(32px,8vw,50px);line-height:1.15;margin-bottom:12px;text-shadow:1px 2px 0 white}
    .subtitle{color:#9b7180;font-size:16px;margin-bottom:25px}
    .letter{
      position:relative;background:linear-gradient(135deg,rgba(255,220,234,.75),rgba(255,255,255,.9),rgba(255,246,190,.55));
      border:1.5px dashed #e7a3bb;border-radius:24px;padding:24px;text-align:left;line-height:1.8;font-size:15.5px;color:#745563;margin:20px 0
    }
    .letter::after{content:"♡";position:absolute;right:17px;top:10px;font-size:28px;color:#e28cab}
    .letter strong{color:#c9537b}.highlight{color:#c9537b;font-weight:bold;background:rgba(255,206,224,.7);padding:3px 8px;border-radius:8px}
    .question{color:#9b6076;font-size:17px;margin-top:10px}
    .buttons{position:relative;width:100%;height:115px;margin-top:10px;display:flex;justify-content:center;align-items:center;gap:18px}
    button{border:none;font-family:inherit;font-weight:bold;font-size:15px;padding:13px 24px;border-radius:50px;cursor:pointer;transition:.2s ease}
    .yes{position:relative;z-index:10;color:white;background:linear-gradient(135deg,#ed86aa,#d95d88);box-shadow:0 5px 0 #bd4f76,0 8px 15px rgba(210,90,130,.2)}
    .yes:hover{transform:scale(1.08)}
    .no{position:relative;z-index:20;color:#a05b74;background:linear-gradient(135deg,#fff,#ffe9f1);border:1px solid #efb3c8;box-shadow:0 5px 0 #e8b4c7}
    .surprise{display:none;margin-top:10px;padding:22px;border-radius:25px;background:linear-gradient(135deg,#ffd6e6,#fff,#fff1bd);border:1.5px solid #e6a0ba;animation:pop .5s ease}
    .surprise.show{display:block}.surprise h2{color:#c9517b;margin-bottom:8px}.surprise p{color:#8e6170;line-height:1.7}
    @keyframes pop{0%{opacity:0;transform:scale(.7)}100%{opacity:1;transform:scale(1)}}
    .footer{margin-top:20px;font-size:12px;color:#b17c8e}
    .heart{position:fixed;top:-30px;pointer-events:none;z-index:100;animation:fall linear forwards}
    @keyframes fall{to{transform:translateY(110vh) rotate(360deg);opacity:0}}
    @media(max-width:500px){
      body{padding:14px}.card{padding:30px 18px;border-radius:28px}.card::before{font-size:45px;top:-23px}
      h1{font-size:35px}.subtitle{font-size:14px}.letter{font-size:14px;padding:20px 17px}
      .decor{transform:scale(.7)}.buttons{height:130px}button{font-size:14px;padding:12px 19px}
    }
  </style>
</head>
<body>
  <div class="decor d1">🎀</div><div class="decor d2">♡</div><div class="decor d3">୨୧</div>
  <div class="decor d4">🎀</div><div class="decor d5">✦</div><div class="decor d6">♡</div>

  <main class="container">
    <div class="card">
      <div class="mini-title">୨୧ SURAT KECIL UNTUK ECI ୨୧</div>
      <h1>Maafin Abib,<br>Eci Buls 🥺</h1>
      <p class="subtitle">Ada sesuatu yang mau Abib sampaikan... ♡</p>

      <div class="letter">
        <p>Hai <strong>Eci Buls</strong> 🤍</p><br>
        <p>Abib mau minta maaf yaa... Abib sadar kalau akhir-akhir ini Abib udah bikin Eci sedih.</p><br>
        <p>Abib juga minta maaf karena <strong>udah ninggalin Eci sampai ketiduran.</strong> Seharusnya Abib nggak begitu dan nggak bikin Eci ngerasa ditinggalin.</p><br>
        <p>Abib juga benar-benar minta maaf karena pernah <strong>ngata-ngatain Eci</strong> sampai bikin Eci sedih. Abib tahu kata-kata itu nggak seharusnya diucapkan, apalagi sampai bikin Eci kepikiran atau sakit hati.</p><br>
        <p>Abib nggak mau membenarkan kesalahan Abib. Abib cuma mau bilang... <span class="highlight">maafin Abib yaa 🥺</span></p><br>
        <p>Abib bakal berusaha buat lebih jaga perasaan Eci dan lebih mikir sebelum ngomong atau melakukan sesuatu.</p><br>
        <p style="text-align:center;">🥺👉🏻👈🏻</p>
      </div>

      <p class="question">Jadi... Eci mau maafin Abib nggak? ♡</p>

      <div class="buttons">
        <button class="yes" id="yesBtn" onclick="forgive()">💗 YES</button>
        <button class="no" id="noBtn">NO 😭</button>
      </div>

      <div class="surprise" id="surprise">
        <div style="font-size:45px;">🎀</div>
        <h2>Makaciw cayanggg 💗</h2>
        <p>Makasih udah mau maafin Abib 🥺<br>Abib sayang Eci Buls ♡</p>
        <div style="margin-top:12px;font-size:22px;letter-spacing:5px;">♡ ୨୧ ♡ ୨୧ ♡</div>
      </div>

      <div class="footer">dibuat khusus untuk Eci Buls ♡<br>— dari Abib 🎀</div>
    </div>
  </main>

  <script>
    const noBtn=document.getElementById("noBtn");
    const buttons=document.querySelector(".buttons");

    function moveNoButton(){
      const areaWidth=buttons.clientWidth, areaHeight=buttons.clientHeight;
      const buttonWidth=noBtn.offsetWidth, buttonHeight=noBtn.offsetHeight;
      const maxX=Math.max(0,areaWidth-buttonWidth), maxY=Math.max(0,areaHeight-buttonHeight);
      noBtn.style.position="absolute";
      noBtn.style.left=(Math.random()*maxX)+"px";
      noBtn.style.top=(Math.random()*maxY)+"px";
    }

    noBtn.addEventListener("mouseenter",moveNoButton);
    noBtn.addEventListener("touchstart",e=>{e.preventDefault();moveNoButton()},{passive:false});
    noBtn.addEventListener("click",e=>{e.preventDefault();moveNoButton()});

    function forgive(){
      document.getElementById("surprise").classList.add("show");
      noBtn.style.display="none";
      document.getElementById("yesBtn").innerHTML="Makaciw cayanggg 💗🎀";
      for(let i=0;i<50;i++) setTimeout(createHeart,i*70);
    }

    function createHeart(){
      const heart=document.createElement("div");
      const symbols=["♡","♥","💗","💖","🎀","✦","୨୧"];
      heart.innerHTML=symbols[Math.floor(Math.random()*symbols.length)];
      heart.className="heart";
      heart.style.left=Math.random()*100+"vw";
      heart.style.fontSize=(16+Math.random()*20)+"px";
      heart.style.color="#e47fa3";
      heart.style.animationDuration=(3+Math.random()*4)+"s";
      document.body.appendChild(heart);
      setTimeout(()=>heart.remove(),7000);
    }
  </script>
</body>
</html>
